<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 阴影层 -->
    <item>
        <shape>
            <padding
                android:bottom="2dp"
                android:left="1dp"
                android:right="1dp"
                android:top="0dp" />
            <solid android:color="#10000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <padding
                android:bottom="2dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp" />
            <solid android:color="#20000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    
    <!-- 前景层 -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#FFFFFF"
                android:startColor="#F0F8FF" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#E1E8ED" />
        </shape>
    </item>
</layer-list>