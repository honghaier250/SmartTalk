<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#20000000" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:bottom="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#E2E8F0" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="#CBD5E1" />
                    <padding android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#15000000" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:bottom="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="#E2E8F0" />
                    <padding android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>